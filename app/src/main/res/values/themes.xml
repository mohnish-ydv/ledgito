<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Goldmine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/nav_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="materialCardViewStyle">@style/Widget.Ledgerly.Card</item>
        <item name="materialButtonStyle">@style/Widget.Ledgerly.Button</item>
        <item name="textInputStyle">@style/Widget.Ledgerly.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.Ledgerly.BottomNavigation</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Ledgerly.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Ledgerly.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Ledgerly.Large</item>
    </style>

    <style name="Theme.Goldmine.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Goldmine</item>
    </style>

    <style name="ShapeAppearance.Ledgerly.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Ledgerly.Medium" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.Ledgerly.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Ledgerly.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Ledgerly.Card.Borderless" parent="Widget.Ledgerly.Card">
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface_container_low</item>
    </style>
    <style name="Widget.Ledgerly.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Ledgerly.Button.Small" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Ledgerly.QuickActionCard" parent="Widget.Ledgerly.Card.Borderless">
        <item name="cardCornerRadius">20dp</item>
        <item name="rippleColor">@color/primary_container</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Ledgerly.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_container_low</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
    <style name="Widget.Ledgerly.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Ledgerly.Nav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Ledgerly.Nav</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.Ledgerly.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Ledgerly.HeroAmount" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/hero_text</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="TextAppearance.Ledgerly.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.Ledgerly.Eyebrow" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="TextAppearance.Ledgerly.Nav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
