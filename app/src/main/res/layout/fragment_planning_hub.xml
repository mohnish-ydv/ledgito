<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_back"
            app:subtitle="Bills, goals, loans and the road ahead"
            app:title="Planning centre" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hero_balance">

            <View
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-48dp"
                android:layout_marginEnd="-38dp"
                android:background="@drawable/bg_hero_orb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXT 30 DAYS"
                    android:textColor="@color/hero_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upcomingAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textAppearance="@style/TextAppearance.Ledgerly.HeroAmount" />

                <TextView
                    android:id="@+id/upcomingCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="No scheduled obligations"
                    android:textColor="@color/hero_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forecastButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="Open cash-flow outlook"
                    android:textColor="@color/on_primary_container"
                    app:backgroundTint="@color/primary_container" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ledgerly.Card.Borderless"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMMITMENTS" android:textColor="@color/on_surface_variant" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/commitmentsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="1" android:text="₹0" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                    <TextView android:id="@+id/commitmentsCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="0 active" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ledgerly.Card.Borderless"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OUTSTANDING" android:textColor="@color/on_surface_variant" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/debtValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="1" android:text="₹0" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                    <TextView android:id="@+id/debtCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="0 balances" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ledgerly.Card.Borderless"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GOALS" android:textColor="@color/on_surface_variant" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/goalsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="1" android:text="₹0" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" />
                    <TextView android:id="@+id/goalsCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:text="0 active" android:textColor="@color/on_surface_variant" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/goalProgressCard"
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open savings goals">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Goal progress"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                    <TextView
                        android:id="@+id/goalProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/income"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/goalProgress"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:progress="0"
                    app:indicatorColor="@color/income"
                    app:trackColor="@color/outline_variant"
                    app:trackCornerRadius="8dp" />
                <TextView
                    android:id="@+id/goalProgressSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add a goal to begin"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/planHealthCard"
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/planHealthScore"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_surface_pill"
                        android:gravity="center"
                        android:text="50"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/planHealthTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Plan health"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <TextView
                            android:id="@+id/planHealthMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Add commitments and goals to build your planning picture."
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/debtStrategyButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="Compare debt payoff strategies" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Upcoming agenda" android:textAppearance="@style/TextAppearance.Ledgerly.Section" />
            <com.google.android.material.button.MaterialButton android:id="@+id/calendarButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Calendar" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:id="@+id/agendaContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Planning tools"
            android:textAppearance="@style/TextAppearance.Ledgerly.Section" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Every tool stays local and works without an account or internet."
            android:textColor="@color/on_surface_variant" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView android:id="@+id/billsCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/expense_container" android:gravity="center" android:text="▤" android:textColor="@color/expense" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Bills" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/emiCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/tertiary_container" android:gravity="center" android:text="▥" android:textColor="@color/tertiary" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="EMIs" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/loansCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/transfer_container" android:gravity="center" android:text="▦" android:textColor="@color/transfer" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Loans" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/goalsCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/income_container" android:gravity="center" android:text="◎" android:textColor="@color/income" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Goals" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/debtCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/expense_container" android:gravity="center" android:text="↘" android:textColor="@color/expense" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Debt payoff" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/subscriptionsCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/primary_container" android:gravity="center" android:text="↻" android:textColor="@color/primary" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Subscriptions" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/plannedCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/surface_container_high" android:gravity="center" android:text="◷" android:textColor="@color/on_surface_variant" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Planned" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/recurringCard" style="@style/Widget.Ledgerly.Card.Borderless" android:layout_width="0dp" android:layout_height="104dp" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@color/primary_container" android:gravity="center" android:text="⟳" android:textColor="@color/primary" android:textSize="20sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Recurring" android:textAppearance="?attr/textAppearanceTitleSmall" /></LinearLayout></com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
