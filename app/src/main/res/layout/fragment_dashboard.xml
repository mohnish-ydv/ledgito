<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="118dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/primary_container"
                android:gravity="center"
                android:text="L"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/on_primary_container"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good evening"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your money space"
                    android:textAppearance="@style/TextAppearance.Ledgerly.Section" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/customiseButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Customise Home"
                app:icon="@drawable/ic_tune"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Settings"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero_balance"
            android:clipToOutline="true">

            <View
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-54dp"
                android:layout_marginEnd="-48dp"
                android:background="@drawable/bg_hero_orb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TOTAL BALANCE"
                        android:textColor="@color/hero_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/hideAmountsButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_surface_pill"
                        android:backgroundTint="@color/white_12"
                        android:contentDescription="Hide amounts"
                        android:padding="10dp"
                        android:src="@drawable/ic_eye" />
                </LinearLayout>

                <TextView
                    android:id="@+id/totalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="₹0.00"
                    android:textAppearance="@style/TextAppearance.Ledgerly.HeroAmount" />

                <TextView
                    android:id="@+id/balanceCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Across active accounts"
                    android:textColor="@color/hero_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THIS MONTH"
                            android:textColor="@color/hero_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/monthNet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₹0"
                            android:textColor="@color/hero_text"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/monthNetCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Net cash flow"
                            android:textColor="@color/hero_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.mohnishraj.goldmineledger.FlowRingView
                        android:id="@+id/flowRing"
                        android:layout_width="112dp"
                        android:layout_height="112dp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quick moves"
            android:textAppearance="@style/TextAppearance.Ledgerly.Section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addExpense"
                style="@style/Widget.Ledgerly.Button.Small"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Expense"
                android:textColor="@color/expense"
                app:backgroundTint="@color/expense_container"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/expense" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addIncome"
                style="@style/Widget.Ledgerly.Button.Small"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Income"
                android:textColor="@color/income"
                app:backgroundTint="@color/income_container"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/income" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTransfer"
                style="@style/Widget.Ledgerly.Button.Small"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Transfer"
                android:textColor="@color/transfer"
                app:backgroundTint="@color/transfer_container"
                app:icon="@drawable/ic_transactions"
                app:iconTint="@color/transfer" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/smartInsightCard"
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">
                <TextView
                    android:id="@+id/smartInsightIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@color/primary_container"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="@color/primary"
                    android:textSize="20sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/smartInsightTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Private money insight"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                    <TextView
                        android:id="@+id/smartInsightMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="3"
                        android:text="Add transactions to unlock useful patterns on this device."
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/primary"
                    android:textSize="28sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/monthlyPulseHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monthly pulse"
                android:textAppearance="@style/TextAppearance.Ledgerly.Section" />

            <TextView
                android:id="@+id/reportButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="Open insights"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/monthlyPulseStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_income_soft"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INCOME"
                    android:textColor="@color/income"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monthIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="₹0"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/income" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_expense_soft"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPENT"
                    android:textColor="@color/expense"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monthExpense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="₹0"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/expense" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/homeTrendCard"
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="30-day cash-flow rhythm"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                    <TextView
                        android:id="@+id/homeTrendCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No data"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
                <com.mohnishraj.goldmineledger.SparklineView
                    android:id="@+id/homeSparkline"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/budgetPulseHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Budget pulse"
                android:textAppearance="@style/TextAppearance.Ledgerly.Section" />

            <TextView
                android:id="@+id/budgetButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="Manage"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/budgetCard"
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/budgetTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No active budget"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/budgetSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Create one to get a calm spending guardrail"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/budgetPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:text="0%"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/budgetProgress"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="16dp"
                    android:progress="0"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/outline_variant"
                    app:trackCornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/planGrowHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Plan &amp; grow"
            android:textAppearance="@style/TextAppearance.Ledgerly.Section" />

        <LinearLayout
            android:id="@+id/planGrowRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/planningHubCard"
                style="@style/Widget.Ledgerly.Card.Borderless"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open planning centre">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="17dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/primary_container"
                        android:gravity="center"
                        android:text="◎"
                        android:textColor="@color/on_primary_container"
                        android:textSize="21sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Planning"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                    <TextView
                        android:id="@+id/planningHubValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:text="No commitments yet"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wealthHubCard"
                style="@style/Widget.Ledgerly.Card.Borderless"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open wealth centre">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="17dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/income_container"
                        android:gravity="center"
                        android:text="◈"
                        android:textColor="@color/income"
                        android:textSize="21sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Wealth"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />
                    <TextView
                        android:id="@+id/wealthHubValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:text="Build your net worth"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent activity"
                android:textAppearance="@style/TextAppearance.Ledgerly.Section" />

            <TextView
                android:id="@+id/viewAllTransactions"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="View all"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        />

        <TextView
            android:id="@+id/recentEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_pill"
            android:gravity="center"
            android:padding="24dp"
            android:text="Your first transaction will appear here."
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dueRecurring"
            style="@style/Widget.Ledgerly.Card.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@color/primary_container"
                    android:gravity="center"
                    android:text="↻"
                    android:textColor="@color/on_primary_container"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Planned money"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/recurringSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="No recurring items due"
                        android:textColor="@color/on_surface_variant" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/primary"
                    android:textSize="28sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exploreButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Explore every money tool"
            app:icon="@drawable/ic_more_grid" />

        <LinearLayout
            android:id="@+id/legacyStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/accountCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/categoryCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/transactionCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout
                android:id="@+id/auditContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
