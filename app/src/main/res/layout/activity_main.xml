<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/main_nav"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomDock"
        style="@style/Widget.Ledgerly.Card.Borderless"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_nav_dock"
        android:elevation="18dp"
        app:cardBackgroundColor="@color/nav_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="18dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:paddingTop="4dp"
            app:itemHorizontalTranslationEnabled="false"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/quickAdd"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="18dp"
        android:contentDescription="Quick add money item"
        android:elevation="24dp"
        android:visibility="visible"
        android:translationZ="24dp"
        app:backgroundTint="@color/primary"
        app:borderWidth="0dp"
        app:ensureMinTouchTargetSize="true"
        app:fabCustomSize="64dp"
        app:maxImageSize="29dp"
        app:rippleColor="@color/primary_container"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/on_primary"
        app:layout_constraintBottom_toBottomOf="@id/bottomDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
